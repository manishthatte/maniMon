[Unit]
# maniMon — the metric recorder.
#
# Author: Manish Jagdish Thatte
#
# This is a USER service, deliberately, and it is deliberately NOT part of
# graphical-session.target.
#
# Recording used to live inside panel_left.py. That made the entire statistics
# history depend on a GTK process surviving: the right panel died silently on
# 17 Aug 2026 and nobody noticed for a day, and every panel restart punches a
# hole in the series. The runs worth measuring here are overnight DFT/GW jobs —
# exactly the ones that outlive a desktop session. With linger enabled the
# recorder keeps sampling across logout, across a crashed panel, and across the
# panels being stopped on purpose. The panels are now pure readers.
Description=maniMon metric recorder
Documentation=https://github.com/manishthatte/maniMon

[Service]
Type=simple
ExecStart=/usr/bin/python3 @INSTALL_DIR@/metrics.py --record

# The sampler is cheap but it is not the point of the machine: physics gets the
# CPU first. Nice 10 keeps it out of the way of a saturating LAMMPS or QE run
# without starving it — the sample cadence is 10 s, so it has plenty of slack.
Nice=10
IOSchedulingClass=idle

# Always come back. A recorder that stays dead after one bad sample defeats the
# purpose; metrics.py already swallows per-sample errors, so a process exit here
# means something unexpected and restarting is the right answer.
Restart=always
RestartSec=10

# SIGTERM is handled in record_loop() so the final samples commit and the
# SQLite connection closes cleanly instead of leaving a hot WAL.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
