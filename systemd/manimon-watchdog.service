[Unit]
# maniMon — panel watchdog (see watchdog.sh for the why).
# Author: Manish Jagdish Thatte
Description=maniMon panel watchdog
Documentation=file:@INSTALL_DIR@/watchdog.sh

[Service]
Type=oneshot
ExecStart=/bin/bash @INSTALL_DIR@/watchdog.sh
Nice=10
# Never let a wedged xprop hold the timer open.
TimeoutStartSec=120

# KillMode=process is what makes this watchdog work at all.
#
# A Type=oneshot service is finished the moment ExecStart returns, and with the
# default KillMode=control-group systemd then kills everything left in the
# service's cgroup — including the panels the watchdog just launched. Observed
# directly: the log said "restart ok", start.sh printed both PIDs, and eight
# seconds later neither process existed. The watchdog was reviving the panels
# and then killing them, once a minute, forever.
#
# With KillMode=process only the main process is signalled, so the relaunched
# panels outlive the watchdog run that started them.
KillMode=process
